# ── Supabase (클라우드 모드) ─────────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 복사
# 두 값이 비어 있으면 앱은 브라우저 저장(localStorage) 모드로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── (선택) 자동 로그인 — 로그인 화면 없이 지정 계정으로 자동 입장 ──
# 두 값을 모두 채우면 사이트 접속 시 로그인 화면 없이 그 계정으로 자동 로그인됩니다.
# ⚠️ 주의: 이 값은 빌드 시 공개 코드에 포함되므로, 사이트 주소를 아는 누구나
#          해당 계정 권한(운영자면 전체 데이터 열람·수정)으로 들어올 수 있습니다.
#          공개 운영 사이트에서는 권장하지 않습니다. 비워 두면 일반 로그인 화면을 사용합니다.
NEXT_PUBLIC_AUTO_LOGIN_EMAIL=
NEXT_PUBLIC_AUTO_LOGIN_PASSWORD=

# ── (선택) AI 포메이션 채팅 — 기본 비활성 ───────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
