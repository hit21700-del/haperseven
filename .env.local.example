# ── Supabase (클라우드 모드) ─────────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 복사
# 두 값이 비어 있으면 앱은 브라우저 저장(localStorage) 모드로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── (선택) AI 포메이션 채팅 — 기본 비활성 ───────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
